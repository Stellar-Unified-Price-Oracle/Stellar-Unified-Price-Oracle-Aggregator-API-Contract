{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraped from scripts/metrics_exporter.py",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Stellar Unified Price Oracle v2 \u2014 per-source drilldown (submission cadence, price comparison, deviation)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Submission Activity",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "title": "Submission Rate by Source (5m)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(oracle_price_submissions_total{contract_id=\"$contract_id\", source_name=~\"$source_name\"}[5m])",
          "legendFormat": "{{source_name}} / {{asset}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "title": "Freshness per Source",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "title": "Time Since Last Submission per Source",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - oracle_source_last_submission_timestamp_seconds{contract_id=\"$contract_id\", source_name=~\"$source_name\"}",
          "legendFormat": "{{source_name}} / {{asset}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "title": "Price Comparison",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "title": "Per-Source Price vs Aggregate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "oracle_source_price{contract_id=\"$contract_id\", source_name=~\"$source_name\"}",
          "legendFormat": "{{source_name}} / {{asset}} (source)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "oracle_latest_price{contract_id=\"$contract_id\"}",
          "legendFormat": "{{asset}} (aggregate)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 103,
      "title": "Deviation Table",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 4,
      "options": {
        "showHeader": true
      },
      "title": "Current Deviation (bps) by Source",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "oracle_source_deviation_bps{contract_id=\"$contract_id\", source_name=~\"$source_name\"}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Source Diversity \u2014 Effective Independence (#399)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 100
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Raw vs Effective Independent Sources",
      "description": "raw_count (nominal) vs effective_independent_count (distinct infra/upstream/owner domains). Gap = Sybil trap.",
      "targets": [
        {
          "expr": "oracle_diversity_raw",
          "legendFormat": "raw"
        },
        {
          "expr": "oracle_diversity_effective",
          "legendFormat": "effective"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 101
      }
    },
    {
      "type": "timeseries",
      "title": "Max Axis HHI + Breach Flag",
      "description": "max HHI over 6 axes; alert threshold 5000. oracle_diversity_low==1 means breach.",
      "targets": [
        {
          "expr": "oracle_diversity_max_hhi",
          "legendFormat": "max HHI"
        },
        {
          "expr": "oracle_diversity_low",
          "legendFormat": "low flag"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 101
      }
    },
    {
      "type": "stat",
      "title": "Largest Failure Domain",
      "description": "Size of single largest (infra,upstream,owner) group.",
      "targets": [
        {
          "expr": "oracle_diversity_largest_domain",
          "legendFormat": "largest domain"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 109
      }
    }
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(oracle_registered_sources_total, contract_id)",
        "hide": 0,
        "includeAll": false,
        "name": "contract_id",
        "label": "Contract ID",
        "options": [],
        "query": {
          "query": "label_values(oracle_registered_sources_total, contract_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(oracle_price_submissions_total{contract_id=\"$contract_id\"}, source_name)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "source_name",
        "label": "Source",
        "options": [],
        "query": {
          "query": "label_values(oracle_price_submissions_total{contract_id=\"$contract_id\"}, source_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Stellar Price Oracle v2 \u2014 Per-Source",
  "uid": "stellar-price-oracle-v2-sources",
  "version": 1
}